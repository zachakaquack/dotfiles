[user]
	email = zach12399@gmail.com
	name = Zach Allen
	signingkey = ~/.ssh/id_ed25519.pub

[init]
	defaultBranch = main

[gpg]
	format = ssh

[commit]
	gpgsign = true
	verbose = true

[tag]
	gpgsign = true

[core]
	editor = nvim
	pager = delta

[interactive]
	diffFilter = delta --color-only

[diff]
	algorithm = histogram
